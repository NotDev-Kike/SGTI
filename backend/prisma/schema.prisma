datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Ticket {
  id                  Int       @id @default(autoincrement())
  nombre_solicitante  String
  departamento        String
  ubicacion           String    @default("Presencial")
  titulo              String
  descripcion         String
  categoria           String    @default("hardware")
  tipo_solicitud      String    @default("incidente")
  prioridad           String    @default("media")
  urgencia            String    @default("media")
  archivo_adjunto     String?
  estado_actual       String    @default("Abierto")
  agente_asignado     String    @default("Auxiliar")
  fecha_creacion      DateTime  @default(now())
  fecha_limite_sla    DateTime?
  fecha_resolucion    DateTime?
  detalles_resolucion String?

  @@map("tickets")
}

model HistorialTicketLog {
  log_id              Int       @id @default(autoincrement())
  ticket_id           Int
  nombre_solicitante  String
  departamento        String
  titulo              String
  categoria           String
  tipo_solicitud      String
  prioridad           String
  agente_asignado     String
  detalles_resolucion String?
  archivado_en        DateTime  @default(now())

  @@map("historial_tickets_log")
}