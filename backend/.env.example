# Puerto de la API backend.
PORT=3001

# Configuracion opcional de correo SMTP. No publicar credenciales reales.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=clave-smtp
SMTP_FROM=SGTI <no-reply@example.com>

# Hora diaria del resumen, entre 0 y 23, en la zona horaria del servidor.
EMAIL_REMINDER_HOUR=8